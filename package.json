{
  "name": "cpsc-3640-dex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deploys TOKEN (BULLDOGS) Uniswap V3 pools against USDC and WETH on Ethereum Sepolia",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "deploy:dry": "node scripts/deploy-pools.mjs --dry-run",
    "deploy": "node scripts/deploy-pools.mjs",
    "deploy:swap": "node scripts/deploy-pools.mjs --swap",
    "deploy:weth:dry": "node scripts/deploy-pools.mjs --pair weth --dry-run",
    "deploy:weth": "node scripts/deploy-pools.mjs --pair weth",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
